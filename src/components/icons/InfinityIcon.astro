---
interface Props {
  variant?: "mono" | "duotone";
  width?: number;
  height?: number;
}

const { variant = "mono", width = 22, height = 22 } = Astro.props;
const viewBox = variant === "duotone" ? "0 0 48 24" : "0 0 24 24";
---

{variant === "duotone" ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={viewBox}
    width={width}
    height={height}
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M24 12c-4-5-8-8-12-8a8 8 0 0 0 0 16c4 0 8-3 12-8z"
      stroke="#4f46e5"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M24 12c4 5 8 8 12 8a8 8 0 0 0 0-16c-4 0-8 3-12 8z"
      stroke="#e11d48"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={viewBox}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width={width}
    height={height}
    aria-hidden="true"
  >
    <path d="M12 12c-2-2.5-4-4-6-4a4 4 0 0 0 0 8c2 0 4-1.5 6-4z" />
    <path d="M12 12c2 2.5 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.5-6 4z" />
  </svg>
)}
