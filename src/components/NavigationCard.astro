---
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<a href={href} class="nav-card" aria-label={title}>
  <div class="nav-card-icon" aria-hidden="true">
    <slot name="icon" />
  </div>

  <h2 class="nav-card-title">
    {title}
    <svg
      class="nav-card-title-arrow"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      width="16"
      height="16"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
        clip-rule="evenodd"
      />
    </svg>
  </h2>

  <p class="nav-card-desc">{description}</p>
</a>
