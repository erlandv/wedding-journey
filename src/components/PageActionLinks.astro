---
interface Props {
  secondaryHref: string;
  secondaryLabel: string;
}

const { secondaryHref, secondaryLabel } = Astro.props;
---

<div class="page-action-links" aria-label="Page navigation actions">
  <a href="/" class="action-link-button action-link-muted">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      width="14"
      height="14"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z"
        clip-rule="evenodd"
      />
    </svg>
    <span>Back to home</span>
  </a>

  <a href={secondaryHref} class="action-link-button action-link-primary">
    <span>{secondaryLabel}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      width="14"
      height="14"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
        clip-rule="evenodd"
      />
    </svg>
  </a>
</div>
