---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavigationCard from "../components/NavigationCard.astro";
import CalendarIcon from "../components/icons/CalendarIcon.astro";
import InfinityIcon from "../components/icons/InfinityIcon.astro";
---

<BaseLayout
  title="Wedding Journey"
  description="A dedicated space to track every year, month, day, and second since my wedding day."
  currentPath="/"
>

  <section class="home-hero" aria-labelledby="home-heading">

    <div class="home-hero-glow-wrap" aria-hidden="true">
      <div class="home-hero-glow"></div>
    </div>

    <h1 id="home-heading" class="page-heading home-heading">
      Wedding Journey
    </h1>

    <p class="page-subheading home-subheading">
      A dedicated space to track every year, month, day, 
      and second since my wedding day.
    </p>

  </section>

  <section class="home-nav-section" aria-label="Navigation">
    <div class="home-nav-grid">
      <NavigationCard
        href="/journey"
        title="Time Journey"
        description="See a precise breakdown of the beautiful time that has passed since my wedding day."
      >
        <CalendarIcon slot="icon" />
      </NavigationCard>
      <NavigationCard
        href="/seconds"
        title="Forever Counter"
        description="Watch every single second continuously build into a lifelong story."
      >
        <InfinityIcon slot="icon" />
      </NavigationCard>
    </div>
  </section>
</BaseLayout>
